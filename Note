name: Build Android APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: 1. Code Checkout Karein
        uses: actions/checkout@v4

      - name: 2. Java Setup Karein
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: 3. Flutter Setup Karein
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.x'
          channel: 'stable'

      - name: 4. Dependencies Get Karein
        run: flutter pub get

      - name: 5. APK Build Karein
        run: flutter build apk --release --no-tree-shake-icons

      - name: 6. APK File Upload Karein
        uses: actions/upload-artifact@v4
        with:
          name: SmartNotes-Release-APK
          path: build/app/outputs/flutter-apk/app-release.apk
